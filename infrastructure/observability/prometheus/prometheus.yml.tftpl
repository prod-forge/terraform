# Rendered by the observability-config module; the project name comes from Terraform.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: nestjs-app
    metrics_path: /metrics
    # Cloud Map registers one A record per running ECS task.
    dns_sd_configs:
      - names:
          - backend.${namespace}
        type: A
        port: ${app_port}
        refresh_interval: 15s
