############################
# AWS KMS - Encryption for Secrets Manager
############################
data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

resource "aws_kms_key" "this" {
  description         = "${var.project}-${var.environment} application secrets and data at rest"
  enable_key_rotation = true

  # The same statement AWS writes when no policy is given: the account controls the key
  # through IAM policies. Written out so the policy is reviewed in code, not implied.
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "EnableIamUserPermissions"
        Effect    = "Allow"
        Principal = { AWS = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root" }
        Action    = "kms:*"
        Resource  = "*"
      },
    ]
  })
}

############################
# AWS Secrets Manager - Manual secrets creation
############################
resource "aws_secretsmanager_secret" "prod_forge_secret" {
  #checkov:skip=CKV2_AWS_57: values are set by hand (Sentry DSN and similar third-party keys) and cannot be rotated by a Lambda; rotate them at the provider and update the secret
  name       = var.secrets_manager_name
  kms_key_id = aws_kms_key.this.arn

  recovery_window_in_days = var.recovery_window_in_days
}

############################
# Generated secrets
############################
resource "random_password" "redis" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "redis_auth" {
  #checkov:skip=CKV2_AWS_57: generated by random_password; rotation needs a coordinated Redis AUTH change and a task restart, not set up yet
  name       = "${var.project}/${var.environment}/redis-auth"
  kms_key_id = aws_kms_key.this.arn

  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret_version" "redis_auth" {
  secret_id     = aws_secretsmanager_secret.redis_auth.id
  secret_string = random_password.redis.result
}

resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  #checkov:skip=CKV2_AWS_57: generated by random_password; rotating the signing key logs every user out, so it is a manual step
  name       = "${var.project}/${var.environment}/jwt-secret"
  kms_key_id = aws_kms_key.this.arn

  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = random_password.jwt.result
}

resource "random_password" "grafana_admin" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "grafana_admin" {
  #checkov:skip=CKV2_AWS_57: generated by random_password and read by the monitoring instance at boot; rotation needs a Grafana password reset, manual for now
  name       = "${var.project}/${var.environment}/grafana-admin"
  kms_key_id = aws_kms_key.this.arn

  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret_version" "grafana_admin" {
  secret_id     = aws_secretsmanager_secret.grafana_admin.id
  secret_string = random_password.grafana_admin.result
}
